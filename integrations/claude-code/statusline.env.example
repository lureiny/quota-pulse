# quota-pulse 状态栏配置样例
#
# 复制到 ~/.config/quota-pulse/statusline.env 并填写,然后 chmod 600 保护 api_key:
#   mkdir -p ~/.config/quota-pulse
#   cp statusline.env.example ~/.config/quota-pulse/statusline.env
#   chmod 600 ~/.config/quota-pulse/statusline.env
#
# 脚本会自动 source 这个文件;也可以直接用环境变量覆盖(环境变量优先)。

# ── 必填 ───────────────────────────────────────────────────────────────
# sub2api 后台地址(不带末尾斜杠也行)
QP_BASE_URL="https://your-sub2api-host"

# sub2api 管理端 API Key(x-api-key 头)。放在这个 600 权限的文件里,别进 settings.json。
# ⚠ 这一项只由你本人在自己的终端里填。别让任何 AI agent(Claude Code / Codex …)代填、代改、
#   代读;也别把 key 粘进对话或用 `!` 前缀运行——那些都会把 key 送进模型上下文/日志。
QP_API_KEY="your-admin-api-key"

# 要展示的账号 id(单个)。不知道 id?在你自己的终端里列(别让 AI agent 拿你的 key 去跑):
#   read -rs -p 'admin key: ' K && echo && \
#   curl -s -H "x-api-key: $K" "$QP_BASE_URL/api/v1/admin/accounts?page_size=200" \
#     | jq -r '.data.items[] | "\(.id)\t\(.name)\t\(.platform)"'; unset K
QP_ACCOUNT_ID="123"

# ── 可选 ───────────────────────────────────────────────────────────────
# 展示哪些窗口,逗号分隔,按此顺序。可选:five_hour, seven_day,
# seven_day_sonnet, seven_day_fable, gemini_* 。默认只显 5h + 7d。
# QP_WINDOWS="five_hour,seven_day"

# 缓存秒数:状态栏每条消息都会触发,TTL 内直接复用上次结果、不打接口。默认 30。
# QP_TTL="30"

# 取数来源:passive=读 sub2api 已缓存值(便宜,默认);active=强制回源(更实时,更贵)。
# QP_SOURCE="passive"

# 行首前缀(如账号昵称)、窗口分隔符。
# QP_PREFIX=""
# QP_SEP=" · "

# 进度条:格数 / 已用格 / 剩余格 / 左右括号。默认 10 格、▰/▱、方括号。
# QP_BAR_WIDTH="10"
# QP_BAR_FILL="▰"
# QP_BAR_EMPTY="▱"
# QP_BAR_LEFT="["
# QP_BAR_RIGHT="]"

# 重置倒计时:1=在每格百分比后显示到期剩余(如 3h20m),0=隐藏。
# QP_SHOW_RESET="1"

# 关掉 ANSI 颜色(或设标准 NO_COLOR=1)。
# QP_COLOR="0"
